#!/bin/zsh
# preinstall — runs as root, before the payload is laid down.
#
# Stops the running watcher so the installer isn't swapping out heic-watch.sh
# underneath a live launchd job. Deliberately never fails the install: if there
# is no console user, or nothing is loaded yet, there is simply nothing to stop.

set -u

LABEL="is.bfc.heic-converter"

CONSOLE_USER="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)"
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" && "$CONSOLE_USER" != "loginwindow" ]]; then
  CONSOLE_UID="$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null)"
  if [[ -n "$CONSOLE_UID" ]]; then
    /bin/launchctl bootout "gui/${CONSOLE_UID}/${LABEL}" 2>/dev/null
  fi
fi

exit 0
