#!/bin/zsh
# heic-converter — control the HEIC watch-folder agent.
#
# The .command installer used a dialog to pick an output format at install time.
# A .pkg can't show one — Installer offers no equivalent, and an osascript prompt
# in a postinstall turns a dismissed dialog into a failed install — so the
# settings live here instead. `heic-converter setup` opens a real settings
# window (packaging/settings-ui.js) with PNG/JPG toggles, a JPEG quality field,
# and a folder browser; `--dialogs` falls back to sequential prompts for SSH.
# Every setting is also individually scriptable.

set -u

LABEL="is.bfc.heic-converter"

# Installed layout, with a fallback so the CLI also works straight from a repo
# checkout during development.
# Resolved at top level on purpose: zsh sets $0 to the *function name* inside a
# function, so reading it later would not give the path to this script.
SELF="${0:A}"
SELF_DIR="${0:A:h}"
if [[ -x "/usr/local/lib/heic-converter/heic-watch.sh" ]]; then
  LIB_DIR="/usr/local/lib/heic-converter"
elif [[ -x "$SELF_DIR/heic-watch.sh" ]]; then
  LIB_DIR="$SELF_DIR"
else
  LIB_DIR="/usr/local/lib/heic-converter"
fi

# setup-agent.sh sits beside the watcher once installed, but in a checkout it
# lives in packaging/ rather than scripts/.
if [[ -x "$LIB_DIR/setup-agent.sh" ]]; then
  SETUP_AGENT="$LIB_DIR/setup-agent.sh"
elif [[ -x "${SELF_DIR:h}/packaging/setup-agent.sh" ]]; then
  SETUP_AGENT="${SELF_DIR:h}/packaging/setup-agent.sh"
else
  SETUP_AGENT="$LIB_DIR/setup-agent.sh"
fi

if [[ -f "$LIB_DIR/settings-ui.js" ]]; then
  SETTINGS_UI="$LIB_DIR/settings-ui.js"
elif [[ -f "${SELF_DIR:h}/packaging/settings-ui.js" ]]; then
  SETTINGS_UI="${SELF_DIR:h}/packaging/settings-ui.js"
else
  SETTINGS_UI="$LIB_DIR/settings-ui.js"
fi

APP_SUPPORT="$HOME/Library/Application Support/heic-converter"
CONFIG_FILE="$APP_SUPPORT/config.conf"
LOG_FILE="$HOME/Library/Logs/heic-converter.log"
ERR_LOG="$HOME/Library/Logs/heic-converter.err.log"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"

die() { print -r -- "error: $*" >&2; exit 1; }

read_config_value() {
  # Read one key without sourcing the file, so `heic-converter status` can't be
  # made to execute whatever ended up in config.conf.
  local key="$1" value
  [[ -f "$CONFIG_FILE" ]] || return 1
  # Quoted form first — everything we write is quoted, and it keeps a '#' inside
  # a folder name from being mistaken for a trailing comment.
  value="$(/usr/bin/sed -n -E "s/^[[:space:]]*${key}=\"([^\"]*)\".*/\1/p" "$CONFIG_FILE" | /usr/bin/tail -n 1)"
  if [[ -z "$value" ]]; then
    value="$(/usr/bin/sed -n -E "s/^[[:space:]]*${key}=([^[:space:]#]*).*/\1/p" "$CONFIG_FILE" | /usr/bin/tail -n 1)"
  fi
  print -r -- "$value"
}

set_config_value() {
  # Rewritten line by line rather than with sed: in a sed replacement '&' means
  # "the whole match", so a folder like ~/Ben & Jerry would corrupt the config.
  local key="$1" value="$2"
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE — run: heic-converter install-agent"
  local tmp line stripped replaced=0
  tmp="$(/usr/bin/mktemp)" || die "could not create a temp file"
  while IFS= read -r line || [[ -n "$line" ]]; do
    stripped="${line#"${line%%[![:space:]]*}"}"
    if [[ "$stripped" == "${key}="* ]]; then
      (( replaced )) || print -r -- "${key}=\"${value}\"" >> "$tmp"
      replaced=1
    else
      print -r -- "$line" >> "$tmp"
    fi
  done < "$CONFIG_FILE"
  (( replaced )) || print -r -- "${key}=\"${value}\"" >> "$tmp"
  /bin/cat "$tmp" > "$CONFIG_FILE"
  /bin/rm -f "$tmp"
}

expand_home() {
  case "$1" in
    '$HOME'/*)   print -r -- "${HOME}/${1#\$HOME/}" ;;
    '~'/*)       print -r -- "${HOME}/${1#\~/}" ;;
    '$HOME'|'~') print -r -- "$HOME" ;;
    *)           print -r -- "$1" ;;
  esac
}

watch_dir() {
  local configured
  configured="$(read_config_value WATCH_DIR)"
  if [[ -n "$configured" ]]; then
    expand_home "$configured"
  else
    print -r -- "$HOME/Downloads"
  fi
}

# launchd bakes WatchPaths into the plist, so a new folder needs the agent
# regenerated rather than just a config edit.
rebuild_agent() {
  [[ -x "$SETUP_AGENT" ]] || die "setup-agent.sh not found (looked in $LIB_DIR)"
  /bin/zsh "$SETUP_AGENT"
}

require_config() {
  [[ -f "$CONFIG_FILE" ]] && return 0
  print -r -- "No config yet — setting up the agent first."
  rebuild_agent
}

cmd_install_agent() { rebuild_agent; }

cmd_format() {
  local value="${1:-}"
  if [[ -z "$value" ]]; then
    print -r -- "$(read_config_value FORMAT)"
    return 0
  fi
  case "$value" in
    png|jpg|both) ;;
    none) ;;
    *) die "invalid format: $value (expected png, jpg, both, or none)" ;;
  esac
  set_config_value FORMAT "$value"
  if [[ "$value" == "none" ]]; then
    print -r -- "both outputs off — conversion is paused (the agent stays installed)"
  else
    print -r -- "format set to $value (applies to the next file converted)"
  fi
}

cmd_quality() {
  local value="${1:-}"
  if [[ -z "$value" ]]; then
    print -r -- "$(read_config_value JPG_QUALITY)"
    return 0
  fi
  [[ "$value" == <-> && "$value" -ge 0 && "$value" -le 100 ]] \
    || die "invalid quality: $value (expected an integer 0-100)"
  set_config_value JPG_QUALITY "$value"
  print -r -- "jpg quality set to $value"
}

cmd_watch_folder() {
  local value="${1:-}"
  if [[ -z "$value" ]]; then
    watch_dir
    return 0
  fi
  value="$(expand_home "$value")"
  value="${value%/}"
  [[ -d "$value" ]] || die "not a directory: $value"
  set_config_value WATCH_DIR "$value"
  print -r -- "watch folder set to $value"
  rebuild_agent
}

# --- Native dialogs ----------------------------------------------------------

require_gui() {
  [[ -x /usr/bin/osascript ]] \
    || die "setup needs macOS dialogs; set values directly instead:
  heic-converter format both
  heic-converter quality 90
  heic-converter watch-folder ~/Downloads"
}

# Folder paths are interpolated into AppleScript source, so quotes and
# backslashes have to be neutralised.
as_escape() { print -r -- "$1" | /usr/bin/sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

SETTINGS_PIDFILE="$APP_SUPPORT/settings.pid"

# Echo the PID of a running settings window, or fail if there isn't one.
settings_window_pid() {
  [[ -f "$SETTINGS_PIDFILE" ]] || return 1
  local pid
  pid="$(/bin/cat "$SETTINGS_PIDFILE" 2>/dev/null)"
  [[ "$pid" == <-> ]] || return 1
  # Check the command line, not just that the PID is alive: PIDs get recycled,
  # and a stale file left by a killed window would otherwise match some
  # unrelated process and suppress the real one from ever opening.
  /bin/ps -p "$pid" -o command= 2>/dev/null | /usr/bin/grep -q 'settings-ui\.js' \
    || return 1
  print -r -- "$pid"
}

raise_settings_window() {
  /usr/bin/osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is $1) to true" \
    >/dev/null 2>&1 \
    || print -r -- "Settings window is already open." >&2
}

ask_format() {
  /usr/bin/osascript 2>/dev/null <<'AS'
tell application "System Events"
  activate
  set theChoice to button returned of (display dialog "Convert HEIC files to:" buttons {"PNG", "JPG", "Both"} default button "Both" with title "HEIC Converter")
end tell
return theChoice
AS
}

ask_quality() {
  local current="$1"
  local -a tiers=(100 95 90 85 80 70 60)
  local list_items="" default_item="" label t

  # Keep a non-standard existing value selectable, rather than silently
  # snapping someone's 72 back to 90.
  if [[ -n "$current" && ${tiers[(Ie)$current]} -eq 0 && "$current" == <-> ]]; then
    default_item="${current}% (current)"
    list_items="\"$default_item\", "
  fi

  for t in $tiers; do
    case $t in
      100) label="100% — largest file" ;;
      90)  label="90% — recommended" ;;
      *)   label="${t}%" ;;
    esac
    list_items+="\"$label\", "
    [[ "$t" == "$current" ]] && default_item="$label"
  done
  list_items="${list_items%, }"
  [[ -z "$default_item" ]] && default_item="90% — recommended"

  local picked
  picked="$(/usr/bin/osascript 2>/dev/null <<AS
set qualityOptions to {$list_items}
tell application "System Events"
  activate
  set picked to choose from list qualityOptions with title "HEIC Converter" with prompt "JPEG quality:" default items {"$(as_escape "$default_item")"} OK button name "Continue"
end tell
if picked is false then return ""
return item 1 of picked
AS
)"
  # "90% — recommended" -> 90
  print -r -- "$picked" | /usr/bin/sed -n -E 's/^([0-9]+)%.*/\1/p'
}

ask_folder() {
  local current="$1"
  [[ -d "$current" ]] || current="$HOME"
  local picked
  picked="$(/usr/bin/osascript 2>/dev/null <<AS
set defaultLoc to POSIX file "$(as_escape "$current")"
tell application "System Events"
  activate
  set theFolder to choose folder with prompt "Watch which folder for new HEIC images?" default location defaultLoc
end tell
return POSIX path of theFolder
AS
)"
  print -r -- "${picked%/}"
}

cmd_setup() {
  require_gui
  require_config

  if [[ "${1:-}" == "--dialogs" ]]; then
    cmd_setup_dialogs
    return $?
  fi

  [[ -f "$SETTINGS_UI" ]] || { cmd_setup_dialogs; return $?; }

  # One window at a time. Both the Applications app and this command funnel
  # through here, so installing (which opens the window) and then opening the
  # app would otherwise leave two independent windows editing the same config.
  local existing
  if existing="$(settings_window_pid)"; then
    raise_settings_window "$existing"
    return 0
  fi

  # The settings window drives AppKit through JXA's ObjC bridge. If that fails
  # on some macOS revision, fall back to the plain dialog chain rather than
  # leaving the user with no way to change settings.
  /usr/bin/osascript -l JavaScript "$SETTINGS_UI" "$SELF" &
  local ui_pid=$!
  print -r -- "$ui_pid" > "$SETTINGS_PIDFILE"
  wait "$ui_pid"
  local rc=$?
  /bin/rm -f "$SETTINGS_PIDFILE"

  if (( rc != 0 )); then
    print -r -- "Settings window failed to open; falling back to dialogs." >&2
    cmd_setup_dialogs
    return $?
  fi

  print_settings
}

print_settings() {
  local fmt; fmt="$(read_config_value FORMAT)"
  print -r -- "Settings:"
  if [[ "$fmt" == "none" ]]; then
    print -r -- "  format:   none (conversion paused)"
  else
    print -r -- "  format:   $fmt"
  fi
  [[ "$fmt" == "jpg" || "$fmt" == "both" ]] \
    && print -r -- "  quality:  $(read_config_value JPG_QUALITY)"
  print -r -- "  watching: $(watch_dir)"
}

# Sequential dialogs — the fallback when the settings window can't run, and
# usable over SSH where a window would be pointless.
cmd_setup_dialogs() {
  local fmt quality folder

  case "$(ask_format)" in
    PNG)  fmt="png" ;;
    JPG)  fmt="jpg" ;;
    Both) fmt="both" ;;
    *) print -r -- "Cancelled."; return 0 ;;
  esac
  set_config_value FORMAT "$fmt"

  # Quality only matters when JPEGs are actually being produced.
  if [[ "$fmt" == "jpg" || "$fmt" == "both" ]]; then
    quality="$(ask_quality "$(read_config_value JPG_QUALITY)")"
    if [[ -n "$quality" ]]; then
      set_config_value JPG_QUALITY "$quality"
    else
      print -r -- "Quality unchanged ($(read_config_value JPG_QUALITY))."
    fi
  fi

  folder="$(ask_folder "$(watch_dir)")"
  if [[ -n "$folder" && -d "$folder" ]]; then
    set_config_value WATCH_DIR "$folder"
  else
    print -r -- "Watch folder unchanged ($(watch_dir))."
  fi

  # Always rebuild: the folder may have changed, and it is cheap and idempotent.
  rebuild_agent

  print -r -- ""
  print_settings
}

# --- Status and diagnostics --------------------------------------------------

agent_loaded() {
  /bin/launchctl print "gui/$(/usr/bin/id -u)/${LABEL}" >/dev/null 2>&1
}

cmd_status() {
  print -r -- "heic-converter $(cmd_version)"
  print -r -- ""
  print -r -- "  agent:    $(agent_loaded && print -r -- "loaded" || print -r -- "not loaded")"
  print -r -- "  plist:    ${PLIST}$([[ -f "$PLIST" ]] || print -r -- "  (missing)")"
  print -r -- "  config:   ${CONFIG_FILE}$([[ -f "$CONFIG_FILE" ]] || print -r -- "  (missing)")"
  print -r -- "  format:   $(read_config_value FORMAT)"
  print -r -- "  quality:  $(read_config_value JPG_QUALITY)"
  print -r -- "  watching: $(watch_dir)"
  print -r -- "  log:      $LOG_FILE"
}

cmd_doctor() {
  local problems=0
  local dir; dir="$(watch_dir)"

  print -r -- "Checking heic-converter..."
  print -r -- ""

  if [[ -x /usr/bin/sips ]]; then
    print -r -- "  [ok]   sips is available"
  else
    print -r -- "  [FAIL] /usr/bin/sips is missing — conversion cannot work"; (( problems++ ))
  fi

  if [[ -x "$LIB_DIR/heic-watch.sh" ]]; then
    print -r -- "  [ok]   watcher installed at $LIB_DIR/heic-watch.sh"
  else
    print -r -- "  [FAIL] watcher not found at $LIB_DIR/heic-watch.sh"; (( problems++ ))
  fi

  if [[ -f "$CONFIG_FILE" ]]; then
    local fmt; fmt="$(read_config_value FORMAT)"
    case "$fmt" in
      png|jpg|both) print -r -- "  [ok]   config format is '$fmt'" ;;
      none) print -r -- "  [ok]   conversion is paused (both outputs off)" ;;
      *) print -r -- "  [FAIL] config FORMAT is '$fmt' (expected png, jpg, both, or none)"; (( problems++ )) ;;
    esac
  else
    print -r -- "  [FAIL] no config at $CONFIG_FILE"; (( problems++ ))
  fi

  if agent_loaded; then
    print -r -- "  [ok]   launchd agent is loaded"
  else
    print -r -- "  [FAIL] launchd agent is not loaded — try: heic-converter install-agent"; (( problems++ ))
  fi

  # A watch folder the plist disagrees with means the agent was never rebuilt
  # after the config changed — exactly the failure the folder picker could cause.
  # Compare against the escaped form: the plist stores "Ben &amp; Jerry", so a
  # raw comparison would report drift forever for any path containing & < >.
  local dir_escaped
  dir_escaped="$(print -r -- "$dir" | /usr/bin/sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
  if [[ -f "$PLIST" ]] && ! /usr/bin/grep -qF "<string>${dir_escaped}</string>" "$PLIST"; then
    print -r -- "  [FAIL] agent is not watching $dir — run: heic-converter install-agent"
    (( problems++ ))
  fi

  if [[ -d "$dir" ]]; then
    if /bin/ls "$dir" >/dev/null 2>&1; then
      print -r -- "  [ok]   $dir is readable from this shell"
    else
      print -r -- "  [FAIL] cannot read $dir from this shell"; (( problems++ ))
    fi
  else
    print -r -- "  [FAIL] watch folder $dir does not exist"; (( problems++ ))
  fi

  # Full Disk Access is granted to the *interpreter*, so this shell being able to
  # read the folder says nothing about whether launchd's zsh can. The log is the
  # only honest signal, and only after something has actually been dropped in.
  if [[ -s "$ERR_LOG" ]]; then
    print -r -- ""
    print -r -- "  Recent agent errors ($ERR_LOG):"
    /usr/bin/tail -n 5 "$ERR_LOG" | /usr/bin/sed 's/^/    /'
  fi

  print -r -- ""
  if (( problems == 0 )); then
    print -r -- "No problems found."
    print -r -- ""
    print -r -- "If conversions still aren't happening, Full Disk Access is the usual"
    print -r -- "cause. Grant it to /bin/zsh:  heic-converter grant-access"
  else
    print -r -- "$problems problem(s) found."
    return 1
  fi
}

cmd_grant_access() {
  print -r -- "Opening System Settings → Privacy & Security → Full Disk Access."
  print -r -- ""
  print -r -- "Add /bin/zsh there (press Cmd+Shift+G in the file picker and type"
  print -r -- "/bin/zsh), then switch it on. launchd runs the watcher via zsh, so"
  print -r -- "the grant has to land on the interpreter — macOS offers no way to"
  print -r -- "scope it to a single script."
  /usr/bin/open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"
}

cmd_run() {
  [[ -x "$LIB_DIR/heic-watch.sh" ]] || die "watcher not found at $LIB_DIR/heic-watch.sh"
  /bin/zsh "$LIB_DIR/heic-watch.sh"
  print -r -- "Pass complete. Recent log lines:"
  [[ -f "$LOG_FILE" ]] && /usr/bin/tail -n 10 "$LOG_FILE" | /usr/bin/sed 's/^/  /'
}

cmd_logs() {
  [[ -f "$LOG_FILE" ]] || die "no log yet at $LOG_FILE"
  /usr/bin/tail -f "$LOG_FILE"
}

cmd_uninstall() {
  local assume_yes=0
  [[ "${1:-}" == "--yes" || "${1:-}" == "-y" ]] && assume_yes=1

  print -r -- "This will remove:"
  print -r -- "  - the launchd agent ($LABEL)"
  print -r -- "  - $PLIST"
  print -r -- "  - $APP_SUPPORT (including your settings)"
  print -r -- "  - /usr/local/lib/heic-converter and /usr/local/bin/heic-converter"
  print -r -- "  - /Applications/HEIC Converter.app"
  print -r -- ""
  print -r -- "Already-converted images are left alone."
  print -r -- ""

  if (( ! assume_yes )); then
    local reply
    read -r "reply?Continue? [y/N] "
    [[ "$reply" == [yY]* ]] || { print -r -- "Cancelled."; return 0; }
  fi

  /bin/launchctl bootout "gui/$(/usr/bin/id -u)/${LABEL}" 2>/dev/null
  /bin/rm -f "$PLIST"
  /bin/rm -rf "$APP_SUPPORT"

  # The system-wide half needs root. Only escalate if it's actually still there.
  if [[ -e /usr/local/lib/heic-converter || -e /usr/local/bin/heic-converter \
        || -e "/Applications/HEIC Converter.app" ]]; then
    print -r -- "Removing system files (requires your password)..."
    /usr/bin/sudo /bin/rm -rf /usr/local/lib/heic-converter /usr/local/bin/heic-converter \
                              "/Applications/HEIC Converter.app"
    /usr/bin/sudo /usr/sbin/pkgutil --forget is.bfc.heic-converter >/dev/null 2>&1
  fi

  print -r -- "Removed. The Full Disk Access grant for /bin/zsh was left in place —"
  print -r -- "remove it yourself in System Settings if you no longer want it."
}

cmd_version() {
  if [[ -f "$LIB_DIR/VERSION" ]]; then
    /bin/cat "$LIB_DIR/VERSION"
  elif [[ -f "${SELF_DIR:h}/VERSION" ]]; then
    /bin/cat "${SELF_DIR:h}/VERSION"
  else
    print -r -- "unknown"
  fi
}

cmd_help() {
  /bin/cat <<'USAGE'
heic-converter — control the HEIC watch-folder agent

Usage: heic-converter <command> [argument]

Settings:
  setup [--dialogs]       Open the settings window: PNG/JPG toggles, JPEG
                          quality, and the watched folder. --dialogs uses
                          plain prompts instead (works over SSH).
  format [png|jpg|both|none]
                          Show or set the output format; none pauses
                          conversion. Takes effect on the
                          next converted file — no reinstall needed.
  quality [0-100]         Show or set JPEG quality (default 90).
  watch-folder [path]     Show or set the watched folder (default ~/Downloads).
                          Setting it rebuilds the agent.

Diagnostics:
  status                  Show agent, config, and watch-folder state.
  doctor                  Diagnose a watcher that isn't converting.
  grant-access            Open the Full Disk Access pane in System Settings.
  logs                    Follow the conversion log.

Other:
  run                     Convert everything in the watch folder right now.
  install-agent           (Re)create and load the launchd agent for this user.
  uninstall [--yes]       Remove the agent, config, and installed files.
  version                 Print the installed version.
  help                    Show this message.
USAGE
}

case "${1:-help}" in
  setup)          shift; cmd_setup "${1:-}" ;;
  format)         shift; cmd_format "${1:-}" ;;
  quality)        shift; cmd_quality "${1:-}" ;;
  watch-folder)   shift; cmd_watch_folder "${1:-}" ;;
  status)         cmd_status ;;
  doctor)         cmd_doctor ;;
  grant-access)   cmd_grant_access ;;
  run)            cmd_run ;;
  logs)           cmd_logs ;;
  install-agent)  cmd_install_agent ;;
  uninstall)      shift; cmd_uninstall "${1:-}" ;;
  version|--version|-V) cmd_version ;;
  help|--help|-h) cmd_help ;;
  *) print -r -- "unknown command: $1" >&2; print -r -- "" >&2; cmd_help >&2; exit 2 ;;
esac
